# Copy this file to ".env" for local development. Never commit the real .env.

PORT=3001
NODE_ENV=development

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB Atlas connection string. Leave empty to use the in-memory store
# (handy for quick local runs, but users and chats reset on every restart).
MONGODB_URI=
MONGODB_DB=shopbot

# Optional: turns on the LLM layer (free key from https://console.groq.com/keys).
# Leave empty and the rule-based bot handles every message.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b